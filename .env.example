# Copy to .env and fill in.

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Frontend origin for CORS. Comma-separate for multiple.
CORS_ORIGIN=http://localhost:5173
# How many reverse proxies sit in front of this process. 0 when running it
# directly, which is everywhere right now. It only matters to the rate limiter,
# which buckets by IP: leave it wrong-low behind a proxy and every user shares
# one bucket, set it wrong-high and a client can forge its own address past the
# limit. Set it to the real hop count when this is deployed.
TRUST_PROXY=0

# ─── Database (Neon) ───────────────────────────────────────────────────────
# Direct (unpooled), no "-pooler" in the host. Used for migrations — PgBouncer's
# transaction mode (what the pooled string goes through) doesn't support the
# SET statements drizzle-kit issues.
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/cgs?sslmode=require
# Pooled, has "-pooler" in the host. What the running app connects with.
DATABASE_URL_POOLED=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/cgs?sslmode=require

# ─── x402 ──────────────────────────────────────────────────────────────────
# Still x402, still USDC — only the facilitator and the chain changed, so the
# names below are accurate rather than legacy. Arc's native USDC, 6 decimals
# through its ERC-20 face.
X402_ASSET=0x3600000000000000000000000000000000000000
X402_ASSET_DECIMALS=6

# The Hedera block that used to sit here is gone, along with HCS_*_TOPIC,
# X402_FACILITATOR_URL, X402_NETWORK and X402_PAY_TO. Stage 6 deleted the code
# that read them; see ../docs/arc-stages.md.

# ─── Arc ───────────────────────────────────────────────────────────────────
# The chain CGS is moving to (see ../docs/arc-stages.md). Optional until the
# stage that removes the Hedera block above; the arc/ service names whichever
# of these is missing the first time it is used.
ARC_NETWORK=testnet
# Testnet defaults to viem's public RPC. Mainnet has none built in, so set it.
# ARC_RPC_URL=
# A dedicated key, never a personal wallet and never reused from testnet to
# mainnet. Pays gas for every write the backend makes, so fund it with a little
# USDC (faucet.circle.com on testnet).
ARC_OPERATOR_KEY=
# From CGS-contracts' deploy output. GameKey's minter and GameRegistry's operator
# are fixed to the deploying address forever, so ARC_OPERATOR_KEY must be it.
ARC_GAME_REGISTRY=
ARC_GAME_KEY=
# Deploys one SplitVault per game, at publish. `vaultOf` is what makes a publish
# safe to retry when the registry write fails after the vault already exists.
ARC_VAULT_FACTORY=
# Where the platform's 5% lands. Defaults to the operator, which is wrong for
# production and fine for testnet: the operator is a hot key that pays gas, and
# revenue should not pile up on one. It is baked into every vault at publish and
# immutable after, so changing it only affects games published later — which is
# correct, not a limitation. It must not equal any game's payee address; the
# vault rejects the same address twice.
ARC_PLATFORM_PAYOUT=

# ─── Circle Facilitator Service ─────────────────────────────────────────────
# Verifies each buyer's EIP-3009 authorization, screens both parties, submits
# the USDC transfer and PAYS THE SETTLEMENT GAS. One host for both networks; the
# CAIP-2 network field selects testnet.
CIRCLE_FACILITATOR_URL=https://api.circle.com
# Free, from https://console.circle.com — and **required**, not an optimisation.
# Settling to a game's SplitVault is impossible without it: the keyless trial
# authenticates with a signature from the key controlling `payTo`, and a vault
# has no key. Without this the server refuses a sale (503) rather than settling
# somewhere it shouldn't. The keyless trial still works when `payTo` is the
# operator itself, which is a local-development convenience only.
#
# Verified live on testnet: with this set, a buyer holding only the price and no
# gas settled to a vault in 4.8s and the vault split the money on receipt.
# Note that settling with the key BINDS that `payTo` to your Circle account and
# permanently ends its keyless-trial allowance. Fine for real vaults; just don't
# do it to an address you still want to test the trial path against.
CIRCLE_API_KEY=
# Where a game's money goes when it has no vault yet (published before the Arc
# port). A sale settled against this has NOT had its split enforced by a
# contract, so leaving it unset is the safer default — a game with no vault then
# fails loudly instead of quietly paying us.
# ARC_FALLBACK_PAY_TO=
# The platform's share of every sale, basis points. 500 = 5%.
PLATFORM_FEE_BPS=500

# ─── Privy ─────────────────────────────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# From the Privy dashboard. Used to verify access tokens offline (no network
# round-trip per request).
PRIVY_VERIFICATION_KEY=

# ─── ENS / Sepolia ──────────────────────────────────────────────────────────
# A public RPC works fine for a hackathon — no signup needed. Swap for a free
# Alchemy/Infura key only if this one starts rate-limiting.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# A dedicated key, generated fresh — not a personal wallet. This account signs
# every ENS transaction the backend makes; fund it with a little Sepolia ETH,
# nothing else. See docs/SETUP.md for the address to send it to.
SEPOLIA_OPERATOR_KEY=
# Sepolia ENSv2-beta addresses, verified against real deployed bytecode, not
# copied from a docs summary — see docs/SETUP.md for how.
ENS_ETH_REGISTRAR=0x7d1b7f586a62ac3f54b9a396849757814283270b
ENS_VERIFIABLE_FACTORY=0x894bc9cc8ff1ad96b8a288c86a8c71d662c07780
ENS_USER_REGISTRY_IMPL=0x47b442d0cf617c41cabaff5f02f44dd1e5f72546
# Your OWN PermissionedResolver proxy, deployed through ENS's
# VerifiableFactory — not a shared one. A resolver you have no EAC roles
# on accepts registrations but reverts every setAddr/setText, so names
# resolve to 0x0. Run `npm run ens:setup -- --yes` to deploy one.
ENS_RESOLVER=
# ENSv2 registration is paid in an approved stablecoin, not ETH — this is a
# self-mintable test token, confirmed with a real eth_call, no faucet needed.
ENS_MOCK_USDC=0xcbfd80f74375c54e545af34788ff465f96f66f05
# Chosen once, at first registration — see docs/SETUP.md.
ENS_PARENT_NAME=
# Output of `tsx scripts/setup-ens.ts`, run once. Every studio subname mints
# against this address — never redeploy it once studios exist under it.

# --- ENSv2: the ETHOnline hackathon deployment ---------------------------
# ENS runs a dedicated ENSv2 deployment for the hackathon, separate from the
# public Sepolia beta on the production docs. Same chain, different contracts,
# its own app and explorer, and names on one are invisible to the other. Every
# address above is the hackathon set.
#
# The two below are ours and are created by `npm run ens:migrate -- --yes`:
# a UserRegistry proxy holding every *.cgs-sanctuary.eth subname, and a
# Permissioned Resolver proxy holding their records. Leave them blank on a
# fresh environment and fill them in from what the migration prints.
ENS_SUBREGISTRY_ADDRESS=

# ─── Storage ───────────────────────────────────────────────────────────────
PINATA_JWT=
PINATA_KEY=
PINATA_SECRET=

# ─── Moderation ────────────────────────────────────────────────────────────
# No CSAM-scanning provider is chosen yet — see docs/stage-2.md. "block" fails
# closed (nothing gets pinned or published); "skip" is a deliberate local
# escape hatch for testing the rest of the pipeline, not a default.
CSAM_MODE=block
# No gateway var on purpose — gatewayUrl() is hardcoded to ipfs.io.
# *.mypinata.cloud returns HTTP 200 with an error page in the body.

# ─── Agent watcher ─────────────────────────────────────────────────────────
AGENT_SWEEP_INTERVAL_MS=5000

# How long before a sale ends the agent makes its decision, and how much notice
# a studio ending a sale early has to give. The same number on purpose: waiting
# for the wire is only safe if nothing can pull the price away inside it.
# Defaults to one hour.
#
# The wait you actually sit through is the sale's remaining length MINUS this,
# so lowering it on its own makes the wait longer. Lower it so you can use a
# sale that is minutes long instead of hours:
#   buffer 2m  + sale ending in 7m  -> decides in 5m
#   buffer 60m + sale ending in 65m -> decides in 5m
# Leave it unset in production.
# AGENT_PURCHASE_BUFFER_MS=3600000

# ─── Groq (Stage 19 — the agent's decision layer) ──────────────────────────
# From console.groq.com. What the agent pays (in inference cost, not tinybar)
# to reason about a contested or ambiguous purchase — see docs/stage-19.md.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AGENT_INFERENCE_PRICE_UNITS=500

# ─── Dev faucet ────────────────────────────────────────────────────────────
# A Privy embedded wallet has no Hedera account until it first receives value,
# and nothing hands out testnet USDC to an arbitrary address — so without this
# a new test buyer can never buy anything. "on" mounts POST /api/dev/faucet,
# which sends from the operator account to the signed-in caller's wallet.
# The env schema refuses to boot with this on when NODE_ENV=production.
DEV_FAUCET=off
# Settlement-asset units per call, and the HBAR sent alongside the first one
# to auto-create the account.
DEV_FAUCET_AMOUNT=5
DEV_FAUCET_HBAR=2

# The account's dedicated gateway subdomain. Find it under Gateways in the
# Pinata dashboard, or with GET https://api.pinata.cloud/v3/ipfs/gateways.
# Without it everything falls back to ipfs.io, which reliably times out (504)
# on freshly pinned content — broken cover art, and a game that never boots.
# Pinata's public gateway works for images. ipfs.io does not: it times out on
# freshly pinned content. A dedicated gateway on a custom domain is what lifts
# the HTML block (ERR_ID:00023) that keeps builds off IPFS delivery.
PINATA_GATEWAY=gateway.pinata.cloud

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Optional. Without it nothing is sent and every message is logged instead, so
# a missing key is silence rather than a crash.
#
# The sending domain is cgs.blackslate.me, added 2026-09-10, on Namecheap
# BasicDNS. Three records, all published and resolving:
#   resend._domainkey.cgs   TXT     p=MIGfMA0GCSq...   (DKIM)
#   rsend.cgs               CNAME   rsend-apne1.forge.rmta.net
#   send.cgs                CNAME   send.forge.rmta.net
# Note "rsend", not "resend", on the middle one. They are easy to confuse and
# only one of them is the DKIM selector.
#
# **The From address has to be on the verified domain.** Until Resend marks it
# verified, a send is refused and logged rather than delivered, exactly the way
# it was refused before under onboarding@resend.dev. That is the same failure
# mode either way, so this is safe to set ahead of verification finishing.
RESEND_API_KEY=
RESEND_FROM=CGS <noreply@cgs.blackslate.me>
# Where links in an email point. A page, not this API. **This has to change at
# deploy** or every invite link mails someone a localhost URL.
APP_URL=http://localhost:5173

# Where `builds:backfill --file` looks for a zip someone sent you. Under
# storage/, which is gitignored.
BUILD_INBOX=storage/incoming
ENS_PERMISSIONED_RESOLVER_IMPL=0xa9d3814ab151bf6e37a427432795371a8361614e
ENS_ETH_REGISTRY=0x1d78834d97c1d7b1a38c1dedbd1a287cfed3971e
ENS_ROOT_REGISTRY=0xe7f0d5724f8337e3aa9a9910540341ff4273fed9
ENS_UNIVERSAL_RESOLVER=0xfea8d4b7fcce0b8765c793d6695eac384aaa458f
