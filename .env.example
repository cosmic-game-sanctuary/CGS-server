# Copy to .env and fill in.

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Frontend origin for CORS. Comma-separate for multiple.
CORS_ORIGIN=http://localhost:5173

# ─── Database (Neon) ───────────────────────────────────────────────────────
# Direct (unpooled), no "-pooler" in the host. Used for migrations — PgBouncer's
# transaction mode (what the pooled string goes through) doesn't support the
# SET statements drizzle-kit issues.
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/cgs?sslmode=require
# Pooled, has "-pooler" in the host. What the running app connects with.
DATABASE_URL_POOLED=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/cgs?sslmode=require

# ─── Hedera ────────────────────────────────────────────────────────────────
# From portal.hedera.com — testnet account, prefunded.
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=
HEDERA_NETWORK=testnet
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# ─── x402 ──────────────────────────────────────────────────────────────────
# Blocky402 testnet needs no API key. Verified live: /supported returns
# hedera:testnet with feePayer 0.0.7162784.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
# 0.0.429274 = testnet USDC (6 decimals, verified on mirror node).
# 0.0.0 = HBAR (8 decimals) — the fallback if the Circle faucet becomes a blocker.
X402_ASSET=0.0.429274
X402_ASSET_DECIMALS=6
# Where buyers pay. MUST be a real 0.0.x account ID, never an EVM address —
# facilitators default to rejecting alias auto-creation.
X402_PAY_TO=0.0.xxxxx

# ─── HCS topics (create once via scripts/create-hcs-topics.ts, then pin) ───
HCS_LISTINGS_TOPIC=
HCS_SALES_TOPIC=
HCS_AGENT_IDENTITY_TOPIC=

# ─── Privy ─────────────────────────────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# From the Privy dashboard. Used to verify access tokens offline (no network
# round-trip per request).
PRIVY_VERIFICATION_KEY=

# ─── ENS / Sepolia (Stage 7 — leave blank until then) ──────────────────────
SEPOLIA_RPC_URL=
ENS_PARENT_NAME=
ENS_SUBREGISTRY_ADDRESS=
ENS_RESOLVER_ADDRESS=

# ─── Storage ───────────────────────────────────────────────────────────────
PINATA_JWT=
PINATA_KEY=
PINATA_SECRET=

# ─── Moderation ────────────────────────────────────────────────────────────
# No CSAM-scanning provider is chosen yet — see docs/stage-2.md. "block" fails
# closed (nothing gets pinned or published); "skip" is a deliberate local
# escape hatch for testing the rest of the pipeline, not a default.
CSAM_MODE=block
# No gateway var on purpose — gatewayUrl() is hardcoded to ipfs.io.
# *.mypinata.cloud returns HTTP 200 with an error page in the body.

# ─── Agent watcher ─────────────────────────────────────────────────────────
AGENT_POLL_INTERVAL_MS=5000
