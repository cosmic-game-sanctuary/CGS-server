{
  "name": "cgs-server",
  "version": "1.0.0",
  "description": "Backend for Cosmic Game Sanctuary \u2014 API, Arc chain integration, and the wishlist agent.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --exclude \"storage/**\" --exclude \"logs/**\" --exclude \"tmp/**\" --exclude \"uploads/**\" --exclude \".cache/**\" src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:fresh": "tsx scripts/migrate-fresh.ts",
    "ens:setup": "tsx scripts/ens-resolver-setup.ts",
    "db:studio": "drizzle-kit studio",
    "topics:create": "tsx scripts/create-hcs-topics.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:wipe": "tsx scripts/seed-dev.ts --wipe",
    "builds:backfill": "tsx scripts/backfill-build-zips.ts",
    "game:delist": "tsx scripts/delist-game.ts",
    "sale:end": "tsx scripts/end-sale.ts",
    "listings:retry": "tsx scripts/retry-announcements.ts",
    "builds:backfill-versions": "tsx scripts/backfill-build-versions.ts",
    "users:backfill-handles": "tsx scripts/backfill-handles.ts",
    "reports:content": "tsx scripts/resolve-content-report.ts",
    "catalog:clean": "tsx scripts/clean-catalog.ts",
    "account:reset": "tsx scripts/reset-account.ts",
    "ens:migrate": "tsx scripts/ens-hackathon-migrate.ts",
    "arc:check": "tsx scripts/arc-chain-check.ts",
    "arc:check:eip3009": "tsx scripts/arc-eip3009-check.ts",
    "arc:check:x402": "tsx scripts/arc-x402-check.ts",
    "arc:check:purchase": "tsx scripts/arc-purchase-check.ts",
    "arc:check:publish": "tsx scripts/arc-publish-check.ts",
    "arc:check:listener": "tsx scripts/arc-agent-listener-check.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmic-game-sanctuary/CGS-server.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/cosmic-game-sanctuary/CGS-server/issues"
  },
  "homepage": "https://github.com/cosmic-game-sanctuary/CGS-server#readme",
  "dependencies": {
    "@hiero-ledger/sdk": "^2.87.0",
    "@noble/hashes": "^2.4.0",
    "@privy-io/node": "^0.34.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "pinata": "^2.5.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "resend": "^6.26.0",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
